{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "references": [
    {
      "path": "../media-core"
    },
    {
      "path": "../media-native"
    }
  ]
}